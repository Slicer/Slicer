#-----------------------------------------------------------------------------
# Verify that the generated copies in this directory agree with their sources:
#
#   deps/*.txt      ->  slicer-deps               (the package lists)
#   inner scripts   ->  install.sh, install.ps1   (the embedded copies)
#
# install.sh and install.ps1 each carry a copy of every inner script, because
# they have to be able to set up a Slicer package built before those scripts
# shipped in it; slicer-deps carries the lists in deps/, because it runs from an
# installed package where deps/ does not exist. All of these are generated by
# tools/sync-embedded.sh, so without this check nothing would notice a source
# edited without re-running it -- and the result would be two different
# versions of the same script in one release, or a slicer-deps that installs
# something other than what deps/ says.
#
# Usage:
#   cmake -DSOURCE_DIR:PATH=<this directory> -P CheckEmbeddedCopies.cmake
#-----------------------------------------------------------------------------

cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR is not set")
endif()

set(problems "")

macro(_report msg)
  list(APPEND problems "${msg}")
endmacro()

#-----------------------------------------------------------------------------
# slicer-deps carries each deps/<manager>.txt as one line:
#
#   DEPS_APT='libglu1-mesa libnss3 ... libasound2t64|libasound2'
#
# tools/sync-embedded.sh renders it by dropping # comments, squeezing out the
# spaces around an "a | b" alternative so it stays one word, and joining the
# words with single spaces. Render each list the same way and compare.
#-----------------------------------------------------------------------------
if(EXISTS "${SOURCE_DIR}/slicer-deps")
  file(READ "${SOURCE_DIR}/slicer-deps" _slicer_deps)

  foreach(_manager IN ITEMS apt dnf pacman)
    string(TOUPPER "${_manager}" _var)
    set(_list "${SOURCE_DIR}/deps/${_manager}.txt")
    if(NOT EXISTS "${_list}")
      _report("deps/${_manager}.txt is missing from ${SOURCE_DIR}")
      continue()
    endif()

    file(READ "${_list}" _expected)
    string(REGEX REPLACE "#[^\n]*" "" _expected "${_expected}")
    string(REGEX REPLACE "[ \t]*\\|[ \t]*" "|" _expected "${_expected}")
    string(REGEX REPLACE "[ \t\r\n]+" " " _expected "${_expected}")
    string(STRIP "${_expected}" _expected)

    if(NOT _slicer_deps MATCHES "\nDEPS_${_var}='([^']*)'\n")
      _report("slicer-deps carries no DEPS_${_var} list")
    elseif(NOT CMAKE_MATCH_1 STREQUAL _expected)
      _report("slicer-deps' DEPS_${_var} differs from deps/${_manager}.txt")
    endif()
  endforeach()
endif()

#-----------------------------------------------------------------------------
# install.sh embeds each script in a quoted heredoc:
#
#   write_inner_slicer_language() {
#     cat > "$1" <<'SLICER_INNER_SCRIPT_EOF'
#   ...script...
#   SLICER_INNER_SCRIPT_EOF
#   }
#
# so the copy is recovered by taking everything between the heredoc opener and
# the line that closes it. The generator guarantees the delimiter never occurs
# inside a script, which is what makes that unambiguous.
#-----------------------------------------------------------------------------
set(_delimiter "SLICER_INNER_SCRIPT_EOF")

if(NOT EXISTS "${SOURCE_DIR}/install.sh")
  _report("install.sh is missing from ${SOURCE_DIR}")
else()
  file(READ "${SOURCE_DIR}/install.sh" _install_sh)

  foreach(_name IN ITEMS slicer-language slicer-deps slicer-shortcuts)
    string(REPLACE "-" "_" _fn "${_name}")
    set(_opener "write_inner_${_fn}() {\n  cat > \"$1\" <<'${_delimiter}'\n")

    string(FIND "${_install_sh}" "${_opener}" _start)
    if(_start EQUAL -1)
      _report("install.sh carries no embedded copy of ${_name}")
      continue()
    endif()

    string(LENGTH "${_opener}" _opener_length)
    math(EXPR _body_start "${_start} + ${_opener_length}")
    string(SUBSTRING "${_install_sh}" ${_body_start} -1 _rest)

    # The script ends with a newline, so the closing delimiter is the first
    # occurrence of the delimiter at the start of a line after it.
    string(FIND "${_rest}" "${_delimiter}\n" _stop)
    if(_stop EQUAL -1)
      _report("install.sh: the embedded copy of ${_name} is not terminated")
      continue()
    endif()
    string(SUBSTRING "${_rest}" 0 ${_stop} _embedded)

    if(NOT EXISTS "${SOURCE_DIR}/${_name}")
      _report("${_name} is missing from ${SOURCE_DIR}")
      continue()
    endif()
    file(READ "${SOURCE_DIR}/${_name}" _actual)

    if(NOT _embedded STREQUAL _actual)
      _report("install.sh's embedded copy of ${_name} differs from ${_name}")
    endif()
  endforeach()
endif()

#-----------------------------------------------------------------------------
# install.ps1 cannot use a heredoc: a PowerShell single-quoted here-string
# always ends at a line starting with '@, and slicer-language.ps1 contains
# exactly that. It embeds each script as one single-quoted string per line
# instead, in a variable of its own:
#
#   $innerLanguagePs1 = @(
#       'line one'
#       'it''s escaped by doubling'
#   ) -join "`n"
#
# Rather than decode that -- ambiguous for a line ending in a quote -- re-encode
# the script the same way and compare. Escaping the quotes before breaking the
# lines makes both steps plain whole-string substitutions. Every encoded line
# starts with a quote, so the closer cannot occur inside an array: the first one
# after an opener is that array's own.
#-----------------------------------------------------------------------------
if(NOT EXISTS "${SOURCE_DIR}/install.ps1")
  _report("install.ps1 is missing from ${SOURCE_DIR}")
else()
  file(READ "${SOURCE_DIR}/install.ps1" _install_ps1)
  set(_ps_closer ") -join \"`n\"\n")

  foreach(_pair IN ITEMS "slicer-language.ps1:innerLanguagePs1" "slicer-shortcuts.ps1:innerShortcutsPs1")
    string(REPLACE ":" ";" _pair "${_pair}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _variable)

    if(NOT EXISTS "${SOURCE_DIR}/${_name}")
      _report("${_name} is missing from ${SOURCE_DIR}")
      continue()
    endif()
    file(READ "${SOURCE_DIR}/${_name}" _actual)

    set(_ps_opener "$${_variable} = @(\n")
    string(FIND "${_install_ps1}" "${_ps_opener}" _start)
    if(_start EQUAL -1)
      _report("install.ps1 carries no embedded copy of ${_name}")
      continue()
    endif()

    string(LENGTH "${_ps_opener}" _opener_length)
    math(EXPR _body_start "${_start} + ${_opener_length}")
    string(SUBSTRING "${_install_ps1}" ${_body_start} -1 _rest)
    string(FIND "${_rest}" "${_ps_closer}" _stop)
    if(_stop EQUAL -1)
      _report("install.ps1: the embedded copy of ${_name} is not terminated")
      continue()
    endif()
    string(SUBSTRING "${_rest}" 0 ${_stop} _embedded)

    # Drop the trailing newline, escape the quotes, then turn every remaining
    # line break into the end of one quoted string and the start of the next.
    string(REGEX REPLACE "\n$" "" _expected "${_actual}")
    string(REPLACE "'" "''" _expected "${_expected}")
    string(REPLACE "\n" "'\n    '" _expected "${_expected}")
    set(_expected "    '${_expected}'\n")

    if(NOT _embedded STREQUAL _expected)
      _report("install.ps1's embedded copy of ${_name} differs from ${_name}")
    endif()
  endforeach()
endif()

#-----------------------------------------------------------------------------
if(problems)
  string(REPLACE ";" "\n  " problems "${problems}")
  message(FATAL_ERROR
    "The generated copies of the installer sources are out of date:\n"
    "  ${problems}\n\n"
    "These copies are generated. Do not edit them by hand: edit the source --\n"
    "deps/*.txt or the inner script -- then run tools/sync-embedded.sh in this\n"
    "directory and commit the regenerated files together with it.\n")
endif()

message(STATUS "The generated copies of the installer sources are up to date.")
