# Checks that the version that VTK reports matches the version in its source code.
#
# VTK does not read its version from a file, but VTKDetermineVersion.cmake runs "git describe" in
# the source tree. A clone without the release tags (a fork pushed without them, or a shallow clone)
# therefore makes VTK declare the version of whatever tag is found, and the build then fails
# much later and somewhere else entirely. VTK only warns if the version found this way disagrees
# with the major and minor version in its CMake/vtkVersion.cmake file. This script makes that
# disagreement an error. It is run after VTK is configured, before the hours it takes to build it.
#
# To fix it, fetch the tags into the VTK source tree, delete <vtk-build-dir>/CMakeCache.txt, and
# rebuild VTK and everything built against it (the version is part of the VTK library names):
#
#   git -C <vtk-source-dir> fetch --tags https://gitlab.kitware.com/vtk/vtk.git
#
# If VTK is cloned from a fork, push the tags to it as well (git push <fork-remote> --tags).
#
# Expects: VTK_SOURCE_DIR, VTK_BINARY_DIR

set(source_version_file "${VTK_SOURCE_DIR}/CMake/vtkVersion.cmake")
# Generated by VTK's configure step, from the version that VTK determined
set(reported_version_file "${VTK_BINARY_DIR}/Common/Core/vtkVersionMacros.h")
foreach(file IN ITEMS "${source_version_file}" "${reported_version_file}")
  if(NOT EXISTS "${file}")
    message(STATUS "VTK version check skipped: ${file} was not found")
    return()
  endif()
endforeach()

# Sets VTK_MAJOR_VERSION and VTK_MINOR_VERSION
include("${source_version_file}")
set(source_version "${VTK_MAJOR_VERSION}.${VTK_MINOR_VERSION}")

file(STRINGS "${reported_version_file}" reported_version REGEX "^#define VTK_VERSION \"")
string(REGEX REPLACE "^#define VTK_VERSION \"([^\"]*)\".*" "\\1" reported_version "${reported_version}")

if(NOT "${reported_version}" MATCHES "^${VTK_MAJOR_VERSION}\\.${VTK_MINOR_VERSION}\\.")
  message(FATAL_ERROR
    "VTK reports version ${reported_version} but its source code is version ${source_version}.\n"
    "  source directory: ${VTK_SOURCE_DIR}\n"
    "  build directory: ${VTK_BINARY_DIR}\n"
    "\n"
    "VTK takes its version from the release tag that 'git describe' finds, so this usually "
    "means that the VTK clone has no release tags (a fork pushed without tags, or a shallow "
    "clone). Building it anyway breaks ITK and Slicer later, with errors that do not point "
    "here. Fetch the tags, delete \"${VTK_BINARY_DIR}/CMakeCache.txt\", and build again:\n"
    "\n"
    "    git -C \"${VTK_SOURCE_DIR}\" fetch --tags https://gitlab.kitware.com/vtk/vtk.git\n"
    "\n"
    "If VTK is cloned from a fork, push the tags to it as well (git push <fork-remote> --tags), "
    "otherwise every fresh build hits this again. See ${CMAKE_CURRENT_LIST_FILE} for details.")
endif()

message(STATUS "VTK version verified: ${reported_version} (source code: ${source_version})")
