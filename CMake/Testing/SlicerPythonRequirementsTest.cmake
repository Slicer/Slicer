function(ExternalProject_FindPythonPackage)
  if(NOT Slicer_USE_SYSTEM_python)
    message(FATAL_ERROR "Unexpected system package lookup for ${proj}")
  endif()
  set(found_system_package TRUE PARENT_SCOPE)
endfunction()

function(ExternalProject_Add name)
  if(Slicer_USE_SYSTEM_python)
    message(FATAL_ERROR "Unexpected bundled installation for ${name}")
  endif()
  cmake_parse_arguments(ep "" "" "INSTALL_COMMAND;LOG_INSTALL;DEPENDS" ${ARGN})
  set(expected_command
    "${PYTHON_EXECUTABLE};-m;pip;install;--require-hashes;-r;${requirements_file}")
  if(NOT ep_INSTALL_COMMAND STREQUAL expected_command)
    message(FATAL_ERROR "Unexpected install command for ${name}: ${ep_INSTALL_COMMAND}")
  endif()
  set(added_project TRUE PARENT_SCOPE)
endfunction()

function(ExternalProject_Add_Empty name)
  if(NOT Slicer_USE_SYSTEM_python)
    message(FATAL_ERROR "Unexpected empty project for ${name}")
  endif()
  set(added_project TRUE PARENT_SCOPE)
endfunction()

function(check_requirements manifest use_system)
  get_filename_component(project_name "${manifest}" NAME_WE)
  if(NOT EXISTS "${Slicer_SOURCE_DIR}/SuperBuild/External_${project_name}.cmake")
    string(REGEX REPLACE "-requirements$" "" project_name "${project_name}")
  endif()
  set(CMAKE_BINARY_DIR "${TEST_BINARY_DIR}/${project_name}/${use_system}")
  set(Slicer_USE_SYSTEM_python "${use_system}")
  set(PYTHON_EXECUTABLE "${TEST_BINARY_DIR}/python")
  set(python_DIR "${TEST_BINARY_DIR}/python-install")
  set(PYTHON_SITE_PACKAGES_SUBDIR "lib/python3.12/site-packages")
  set(added_project FALSE)
  set(found_system_package FALSE)
  set(output "${CMAKE_BINARY_DIR}/${project_name}-requirements.txt")
  file(REMOVE "${output}")

  include("${Slicer_SOURCE_DIR}/SuperBuild/External_${project_name}.cmake")

  if(NOT added_project)
    message(FATAL_ERROR "No external project added for ${project_name}")
  endif()
  if(use_system)
    if(EXISTS "${output}" OR NOT found_system_package)
      message(FATAL_ERROR "System package behavior changed for ${project_name}")
    endif()
  else()
    if(NOT EXISTS "${output}")
      message(FATAL_ERROR "No build requirements generated for ${project_name}")
    endif()
    file(SHA256 "${manifest}" expected_hash)
    file(SHA256 "${output}" actual_hash)
    if(NOT expected_hash STREQUAL actual_hash)
      message(FATAL_ERROR "Build requirements differ from ${manifest}")
    endif()
  endif()
endfunction()

file(GLOB manifests "${Slicer_SOURCE_DIR}/SuperBuild/Python/*requirements.txt")
if(NOT manifests)
  message(FATAL_ERROR "No SuperBuild Python requirements found")
endif()
foreach(manifest IN LISTS manifests)
  check_requirements("${manifest}" FALSE)
  check_requirements("${manifest}" TRUE)
endforeach()

file(GLOB external_projects "${Slicer_SOURCE_DIR}/SuperBuild/External_python*.cmake")
foreach(external_project IN LISTS external_projects)
  file(READ "${external_project}" contents)
  if(contents MATCHES "file\\(WRITE \\$\\{requirements_file\\}")
    message(FATAL_ERROR "Inline requirements are not visible to GitHub: ${external_project}")
  endif()
  if(contents MATCHES "pip install .*--require-hashes")
    get_filename_component(project_name "${external_project}" NAME_WE)
    string(REGEX REPLACE "^External_" "" project_name "${project_name}")
    if(NOT project_name MATCHES "-requirements$")
      string(APPEND project_name "-requirements")
    endif()
    if(NOT EXISTS "${Slicer_SOURCE_DIR}/SuperBuild/Python/${project_name}.txt")
      message(FATAL_ERROR "Missing requirements manifest for ${project_name}")
    endif()
  endif()
endforeach()

message(STATUS "SUCCESS: Bundled and system Python requirement wiring verified")
