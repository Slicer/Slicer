            </property>
            <item row="0" column="0">
             <widget class="QLabel" name="ModelBasedExtrapolationDistanceLabel">
              <property name="toolTip">
               <string>How far beyond the points the transform is fitted.</string>
              </property>
              <property name="text">
               <string>Extrapolation distance:</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="ctkDoubleSpinBox" name="ModelBasedExtrapolationDistanceSpinBox">
              <property name="toolTip">
               <string>How far beyond the points the transform is fitted. Within this distance it follows the displacements smoothly; beyond it, see Border mode. Set to a tenth of the diagonal of the points when the transform is created.</string>
              </property>
              <property name="suffix">
               <string> mm</string>
              </property>
              <property name="decimals">
               <number>2</number>
              </property>
              <property name="minimum">
               <double>0.000000</double>
              </property>
              <property name="maximum">
               <double>100000.000000</double>
              </property>
              <property name="singleStep">
               <double>1.000000</double>
              </property>
              <property name="value">
               <double>0.000000</double>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="ModelBasedControlPointSpacingLabel">
              <property name="toolTip">
               <string>Spacing of the B-spline control points of the coarsest level.</string>
              </property>
              <property name="text">
               <string>Coarsest spacing:</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="ctkCoordinatesWidget" name="ModelBasedControlPointSpacingWidget">
              <property name="toolTip">
               <string>Spacing of the B-spline control points of the coarsest level, along each axis. Each further level halves it. 0 along an axis means automatic: a tenth of the size of the fitted region along that axis.</string>
              </property>
              <property name="decimals">
               <number>2</number>
              </property>
              <property name="singleStep">
               <double>1.000000</double>
              </property>
              <property name="minimum">
               <double>0.000000</double>
              </property>
              <property name="maximum">
               <double>100000.000000</double>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QLabel" name="ModelBasedMinimumControlPointSpacingLabel">
              <property name="toolTip">
               <string>Smallest spacing of the B-spline control points that refinement may produce.</string>
              </property>
              <property name="text">
               <string>Finest spacing:</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="ctkDoubleSpinBox" name="ModelBasedMinimumControlPointSpacingSpinBox">
              <property name="toolTip">
               <string>Smallest spacing of the B-spline control points that refinement may produce. A smaller spacing follows the displacements more closely, at the cost of time and memory. Set to a hundredth of the size of the fitted region when the transform is created.</string>
              </property>
              <property name="suffix">
               <string> mm</string>
              </property>
              <property name="decimals">
               <number>3</number>
              </property>
              <property name="minimum">
               <double>0.000000</double>
              </property>
              <property name="maximum">
               <double>100000.000000</double>
              </property>
              <property name="singleStep">
               <double>0.100000</double>
              </property>
              <property name="value">
               <double>0.000000</double>
              </property>
             </widget>
            </item>
            <item row="3" column="0">
             <widget class="QLabel" name="ModelBasedMaximumNumberOfLevelsLabel">
              <property name="toolTip">
               <string>Largest number of refinement levels.</string>
              </property>
              <property name="text">
               <string>Maximum levels:</string>
              </property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QSpinBox" name="ModelBasedMaximumNumberOfLevelsSpinBox">
              <property name="toolTip">
               <string>Largest number of refinement levels. Each level halves the control point spacing and needs about 8 times as much memory.</string>
              </property>
              <property name="minimum">
               <number>1</number>
              </property>
              <property name="maximum">
               <number>16</number>
              </property>
              <property name="value">
               <number>8</number>
              </property>
             </widget>
            </item>
            <item row="4" column="0">
             <widget class="QLabel" name="ModelBasedToleranceLabel">
              <property name="toolTip">
               <string>The fit is refined until the largest error at the points is below this.</string>
              </property>
              <property name="text">
               <string>Tolerance:</string>
              </property>
             </widget>
            </item>
            <item row="4" column="1">
             <widget class="ctkDoubleSpinBox" name="ModelBasedToleranceSpinBox">
              <property name="toolTip">
               <string>The fit is refined until the largest error at the points is below this distance, or the finest spacing or the maximum number of levels is reached. Set to a thousandth of the largest displacement when the transform is created.</string>
              </property>
              <property name="suffix">
               <string> mm</string>
              </property>
              <property name="decimals">
               <number>4</number>
              </property>
              <property name="minimum">
               <double>0.000000</double>
              </property>
              <property name="maximum">
               <double>100000.000000</double>
              </property>
              <property name="singleStep">
               <double>0.001000</double>
              </property>
              <property name="value">
               <double>0.000000</double>
              </property>
             </widget>
            </item>
            <item row="5" column="0">
             <widget class="QLabel" name="ModelBasedUseLinearApproximationLabel">
              <property name="toolTip">
               <string>Start the fit from the linear transform that best matches the displacements.</string>
              </property>
              <property name="text">
               <string>Linear approximation:</string>
              </property>
             </widget>
            </item>
            <item row="5" column="1">
             <widget class="QCheckBox" name="ModelBasedUseLinearApproximationCheckBox">
              <property name="toolTip">
               <string>Start the fit from the linear transform that best matches the displacements, so that away from the points the transform follows their overall linear trend (a rotation, a scaling) instead of flattening out.</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="6" column="0">
             <widget class="QLabel" name="ModelBasedBorderModeLabel">
              <property name="toolTip">
               <string>What the transform does beyond the fitted region.</string>
              </property>
              <property name="text">
               <string>Border mode:</string>
              </property>
             </widget>
            </item>
            <item row="6" column="1">
             <widget class="QComboBox" name="ModelBasedBorderModeComboBox">
              <property name="toolTip">
               <string>What the transform does beyond the fitted region (the points and the extrapolation distance around them): keep the displacement at the border of the region, have no displacement outside it, or fade the displacement to zero at its border.</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </widget>
