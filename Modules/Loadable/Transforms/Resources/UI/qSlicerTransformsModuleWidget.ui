         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="ModelBasedDisplacementScaleLabel">
           <property name="toolTip">
            <string>Multiplies the displacements of the transform.</string>
           </property>
           <property name="text">
            <string>Displacement scale:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <layout class="QHBoxLayout" name="ModelBasedDisplacementScaleLayout">
           <item>
            <widget class="ctkSliderWidget" name="ModelBasedDisplacementScaleSliderWidget">
             <property name="toolTip">
              <string>Multiplies the displacements of the transform: 0 is the identity, 1 the fitted displacements, 2 twice as much. For exaggerating small deformations or animating them. The fit is not affected.</string>
             </property>
             <property name="decimals">
              <number>2</number>
             </property>
             <property name="minimum">
              <double>0.000000000000000</double>
             </property>
             <property name="maximum">
              <double>10.000000000000000</double>
             </property>
             <property name="singleStep">
              <double>0.010000000000000</double>
             </property>
             <property name="value">
              <double>1.000000000000000</double>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="ModelBasedDisplacementScaleReverseButton">
             <property name="toolTip">
              <string>Move points the opposite way: multiplies the displacements by the negative of the displacement scale.</string>
             </property>
             <property name="text">
              <string>Reverse</string>
             </property>
             <property name="checkable">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="ModelBasedFitResultLabel">
           <property name="toolTip">
            <string>How closely the transform reproduces the displacements at the points.</string>
           </property>
           <property name="text">
            <string>Fit:</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QLabel" name="ModelBasedFitResultValueLabel">
           <property name="toolTip">
