 <connections>
  <connection>
   <sender>qMRMLVectorFieldDisplayWidget</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>ScalarsDisplayWidget</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>140</x>
     <y>5</y>
    </hint>
    <hint type="destinationlabel">
     <x>62</x>
     <y>260</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>qMRMLVectorFieldDisplayWidget</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>SamplingRegionNodeComboBox</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
