     <layout class="QVBoxLayout" name="vectorFieldDisplaysLayout">
      <item>
       <widget class="QLabel" name="NoVectorFieldLabel">
        <property name="text">
         <string>The selected node has no vector field: a model needs a point or cell data array with 3 components, a volume needs at least 3 components per voxel.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="displayNodesLayout">
        <item>
         <widget class="QListWidget" name="DisplayNodesListWidget">
          <property name="toolTip">
           <string>Vector field displays of the selected node. Each is drawn on its own: for example glyphs and streamlines of the same field. Uncheck a display to hide it; it then stays hidden when the node is shown by its eye icon.</string>
          </property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
