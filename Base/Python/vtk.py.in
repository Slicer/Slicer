"""Lazily-loading vtk module (generated from vtk.py.in by GenerateLazyVtkModule.py).

Provides the same namespace as the eager ``vtk`` module distributed with
VTK, but each attribute access imports only the vtkmodules submodule that
provides it. Import ``vtkmodules.all`` to force everything to load.
"""

import importlib as _importlib

import vtkmodules as _vtkmodules

# Make this module look like the vtkmodules package so that submodule
# imports such as ``import vtk.util.numpy_support`` keep working.
__path__ = _vtkmodules.__path__
__version__ = _vtkmodules.__version__

# Convenience re-exports, kept eager to match the eager shim.
from vtkmodules.util.vtkConstants import vtkImageScalarTypeNameMacro  # noqa: F401
from vtkmodules.util.misc import calldata_type  # noqa: F401
from vtkmodules.util.vtkVariant import *  # noqa: F403

# Maps each public attribute of the vtk module to the vtkmodules submodule
# that provides it. Filled in at build time by GenerateLazyVtkModule.py.
_ATTRIBUTE_MODULE = @VTK_ATTRIBUTE_MODULE@


def __getattr__(name):
    module_name = _ATTRIBUTE_MODULE.get(name)
    if module_name is None:
        raise AttributeError("module 'vtk' has no attribute %r" % (name,))
    module = _importlib.import_module("vtkmodules." + module_name)
    value = getattr(module, name)
    globals()[name] = value
    return value


def __dir__():
    return sorted(set(list(globals()) + list(_ATTRIBUTE_MODULE)))


# Tell VTK which module wraps each class. When a C++ method returns an object
# whose class has not been imported yet, the wrapping imports the module that
# provides it (see vtkPythonUtil::GetObjectFromPointer); without this, such an
# object would be returned as its nearest already-imported base class, e.g. a
# vtkChartXY as a vtkContextItem. Older vtkmodules packages lack the table.
if hasattr(_vtkmodules, "register_class_modules"):
    _vtkmodules.register_class_modules(_ATTRIBUTE_MODULE)
